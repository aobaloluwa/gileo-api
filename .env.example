# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/gileo?schema=public
SHADOW_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/gileo_shadow?schema=public
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=
EBOOK_STORAGE_DIR=./private-ebooks
