# Copy to .env and fill in local values. Never commit .env.
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# PostgreSQL connection string (Prisma 7 reads this from prisma7.config.ts)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/gileo?schema=public
SHADOW_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/gileo_shadow?schema=public

# Generate strong, unique values for each environment.
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# Email configuration used by the existing authentication flow
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=GILEO Medicals <no-reply@example.com>

# Google sign-in (optional; configure the existing Google auth service)
GOOGLE_CLIENT_ID=

# Paystack: paste your secret key here locally. Use a test secret key for development.
# Do not expose this key in the React Native app, public variables, or source control.
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_CALLBACK_URL=gileo://payment/callback
